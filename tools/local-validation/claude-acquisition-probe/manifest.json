{
  "manifest_version": 3,
  "name": "QuotaBar local Claude acquisition probe",
  "version": "0.1.0",
  "description": "Temporary local-only sanitized acquisition probe. Synthetic validation only until approved.",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://claude.ai/*"],
    "js": ["isolated-entry.js"],
    "run_at": "document_start"
  }, {
    "matches": ["https://claude.ai/*"],
    "js": ["main-entry.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }]
}
